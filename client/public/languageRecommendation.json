    "appName": "Sahkar Sathi",
    "appNativeName": "सहकार साथी",
    "defaultLanguage": "en",
    "fallbackLanguage": "hi",
    "totalLanguagesSupported": 14,
    "storageKeys": {
      "preferredLanguage": "language",
      "legacyLanguage": "sahkar_preferred_language",
      "recommendationDismissed": "sahkar_lang_recommendation_dismissed",
      "userRole": "sahkar_user_role",
      "autoConverted": "sahkar_lang_auto_converted"
    }
  },
  "conversionDirectives": {
    "autoConvertOnHighConfidence": true,
    "promptBannerOnMediumConfidence": true,
    "detectNavigatorLanguage": true,
    "detectGeoLocation": true,
    "preserveUserSelection": true,
    "updateDocumentAttributes": {
      "htmlLang": true,
      "direction": true,
      "rtlClass": "rtl"
    },
    "detectionPriority": [
      "stored_user_preference",
      "url_query_parameter",
      "browser_navigator_languages",
      "ip_geolocation_state",
      "system_default_fallback"
    ]
  },
